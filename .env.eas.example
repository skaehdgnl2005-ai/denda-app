# 된다 (DenDa) — EAS Build 환경변수·시크릿 manifest (S13)
#
# 이 파일은 "어떤 env가 어디에 사는가"의 단일 진실. 실제 값은 절대 commit 금지.
# 두 곳에 나눠 산다:
#   (A) EAS Environment Variables — 모바일 앱 빌드(eas build)에 주입. EXPO_PUBLIC_* + 빌드 메타.
#   (B) Supabase Edge Function secrets — 서버에만. CLAUDE.md rule 7: secret은 클라 expose 절대 금지.
#
# 절대 규칙: NAVER_CLIENT_SECRET·KAKAO_ADMIN_KEY·GEMINI_API_KEY·HMAC_SECRET·GOOGLE_CALENDAR_CLIENT_SECRET은
# (A)에 넣으면 안 됨 (앱 번들에 박혀 추출 가능). 반드시 (B) Supabase에만.

# ════════════════════════════════════════════════════════════════════
# (A) EAS Environment Variables  →  eas env:create
# ════════════════════════════════════════════════════════════════════
# visibility 가이드:
#   plaintext  — 빌드 로그에도 노출 OK (public 값)
#   sensitive  — 로그에 가려지지만 빌드 산출물엔 포함 (EXPO_PUBLIC_*은 어차피 번들에 들어감)
#   secret     — EAS에서 읽기 불가, 서버 빌드에만. (A)에는 거의 안 씀 → (B) Supabase 사용
#
# 환경(environment)은 eas.json build profile의 "environment"와 매칭: development / preview / production
#
# 예) production 환경에 등록:
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value "https://xxx.supabase.co" --visibility plaintext
#   (development / preview에도 각각 등록. 또는 --environment 여러 번)

# --- Supabase (client) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co          # plaintext
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                        # sensitive (anon key는 public 설계지만 가려서 관리)

# --- Kakao (client SDK 초기화용 — public 인정) ---
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your-kakao-native-key             # sensitive
# 주의: Kakao REST API key는 클라가 아니라 Supabase Auth dashboard(Kakao OIDC provider)에 등록.
# Kakao Admin key는 (B) Supabase Edge에만.

# --- Naver Map SDK (client expose 불가피 — SDK 한계) ---
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-map-client-id          # sensitive

# --- EAS / Push ---
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id                    # plaintext (app.config.ts extra.eas.projectId와 동일)

# ════════════════════════════════════════════════════════════════════
# (B) Supabase Edge Function secrets  →  supabase secrets set
# ════════════════════════════════════════════════════════════════════
# 클라이언트 번들에 절대 들어가면 안 되는 값. EXPO_PUBLIC_ prefix 금지.
#
# 예) supabase secrets set NAVER_CLIENT_ID=xxx NAVER_CLIENT_SECRET=yyy
#     (또는 supabase secrets set --env-file ./supabase/.env)

KAKAO_ADMIN_KEY=your-kakao-admin-key                              # Kakao Local proxy 도입 시 (Phase 1+2 미사용)
GEMINI_API_KEY=your-gemini-api-key                                # OCR (ocr_everytime)
HMAC_SECRET=generate-32byte-random-here                           # D28 deferred deep link fingerprint salt
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id                   # S06 Calendar sync
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-secret                  # S06 Calendar sync (secret!)
NAVER_CLIENT_ID=your-naver-search-client-id                       # S16 지역검색 (naver_local_search Edge)
NAVER_CLIENT_SECRET=your-naver-search-client-secret               # S16 지역검색 (secret!)

# ════════════════════════════════════════════════════════════════════
# (C) 빌드 자격증명 (값이 아니라 계정·인증서) — eas.json submit + eas credentials
# ════════════════════════════════════════════════════════════════════
# 아래는 env가 아니라 운영 prereq. docs/EAS_BUILD_RUNBOOK.md 참조.
#   iOS:     Apple Developer 계정 ✅ → eas credentials가 distribution cert + provisioning profile 자동 관리
#   Android: keystore는 첫 eas build에서 EAS가 자동 생성 (Play Console 불필요)
#   제출:    iOS=App Store Connect API key, Android=Play service account JSON (Play 배포 시점에만)
