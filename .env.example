# 된다 (DenDa) — Environment variables template
# 실제 값은 .env.local (git ignored). 절대 commit 금지.
# CLAUDE.md 규칙 7: HMAC, Kakao secret, Gemini key는 Edge Function only.

# === Supabase ===
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# === EAS / Expo (S13) ===
# Push 토큰 발급(getExpoPushTokenAsync)에 사용. app.config.ts extra.eas.projectId와 동일 값.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# === Kakao ===
# Mobile SDK key (클라이언트 expose OK — public)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your-kakao-native-key
EXPO_PUBLIC_KAKAO_REST_API_KEY=your-kakao-rest-key
# Edge Function only — 절대 EXPO_PUBLIC_ prefix 금지
KAKAO_ADMIN_KEY=your-kakao-admin-key

# === Naver Map ===
# SDK key는 client expose 불가피 (SDK 한계)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-client-id
# 지도 렌더 게이트(D38). Client ID 발급 + EAS 네이티브 빌드 후 'true'로 켜면 네이티브 지도 점등.
# placeholder/미설정 상태에서는 "리스트로 보기" placeholder 유지 (코드 변경 0으로 전환).
EXPO_PUBLIC_MAP_ENABLED=false

# === Google OAuth (Calendar 동의 — S06) ===
# Web/iOS/Android OAuth Client ID. Google Cloud Console에서 발급.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# === Naver 지역검색 Open API (S16 — Edge Function only) ===
# Naver Map SDK key와 별개 제품. Client Secret 필요 → Edge proxy(naver_local_search) 경유.
# 절대 EXPO_PUBLIC_ prefix 금지 (rule 7).
NAVER_CLIENT_ID=your-naver-search-client-id
NAVER_CLIENT_SECRET=your-naver-search-client-secret

# === Gemini Vision (OCR) — Edge Function only ===
GEMINI_API_KEY=your-gemini-api-key

# === Attribution (D28 자체 구축 — SaaS 없음) ===
# Vercel subdomain `denda.vercel.app/g/<token>`을 단축 URL host로 사용.
# Fingerprint 해시는 HMAC_SECRET 재사용 (위에 정의).
# 별도 SDK key 필요 없음.

# === HMAC secret — Edge Function only (D28 자체 deferred deep link fingerprint salt) ===
# 사용처: web-guest /g/<token> route 진입 시 ip_hash·ua_hash 생성
# (D21 synthetic email 용도는 D29로 폐기. secret 값은 D28에서 계속 사용)
HMAC_SECRET=generate-32byte-random-here

# === Google Calendar — Edge Function only ===
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-secret
