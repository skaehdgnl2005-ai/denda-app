{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/design-guard.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(npx expo:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npx maestro:*)",
      "Bash(npx playwright:*)",
      "Bash(supabase:*)",
      "Bash(deno:*)",
      "Bash(deno test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git worktree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Glob(./docs/archive/**)",
      "Grep(./docs/archive/**)"
    ]
  }
}
